GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# LLM model configuration
# Global fallback model (used if per-agent models below are not set)
GEMINI_MODEL=gemini-2.5-flash

# Per-agent model overrides (optional; each falls back to GEMINI_MODEL if unset)
AGENT_MODEL=gemini-2.5-flash        # Main Slides/Drive agent
PLANNER_MODEL=gemini-2.5-flash      # Planner agent (plan generation)
RESEARCH_MODEL=gemini-2.5-flash     # Research agent (documents + web search)

# Agent loop limits
AGENT_MAX_ROUNDS=40                 # Max tool-call loops for main agent (default 40)
SHEETS_AGENT_MAX_ROUNDS=40          # Max tool-call loops for Sheets agent (default 40)
RESEARCH_MAX_ROUNDS=15              # Max tool-call loops for research agent (default 15)
GWS_MCP_SERVICES=slides,drive

# SQLite database (default: ./database/app.db)
DATABASE_URL=sqlite:///./database/app.db

# Public URL for icons and logos (required for Google Slides createImage when running locally).
# Use localtunnel to expose your backend without deploying:
#   1. Start backend: python run.py  (port 8000)
#   2. In another terminal: npx localtunnel --port 8000 --subdomain ib-scaffold
#   3. Copy the URL (e.g. https://ib-scaffold.loca.lt) and set it here:
# ICON_BASE_URL=https://ib-scaffold.loca.lt
#
# Or use: ./scripts/start-tunnel.sh --subdomain ib-scaffold  (from project root)
# On Windows: .\scripts\start-tunnel.ps1 -Subdomain ib-scaffold
#
# Note: If localtunnel's "reminder" page blocks Google's fetch, try ngrok instead.

# Icon embedding model (if 404, try: models/text-embedding-004)
# ICON_EMBEDDING_MODEL=models/gemini-embedding-001

# Web search configuration for research agent
# Uses Gemini's built-in Google Search grounding; no extra API key needed.
# Optional: override model used specifically for web search (otherwise uses RESEARCH_MODEL/GEMINI_MODEL).
# RESEARCH_SEARCH_MODEL=gemini-2.5-flash
